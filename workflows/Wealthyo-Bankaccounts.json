      "notesInFlow": true,
      "parameters": {
        "jsCode": "const root = $json;\nconst body = root.body ?? root.data ?? root;\nconst submission = body.submission ?? body;\n\n// Convert Fillout questions array into { field_name: value }\nfunction questionMap(input) {\n  const out = {};\n  const lists = [\n    input.questions,\n    input.submission?.questions,\n    input.body?.submission?.questions,\n  ].filter(Array.isArray);\n\n  for (const list of lists) {\n    for (const q of list) {\n      if (!q?.name) continue;\n      out[q.name] = q.value ?? \"\";\n    }\n  }\n\n  return out;\n}\n\nconst q = questionMap(body);\n\nfunction pick(...keys) {\n  for (const key of keys) {\n    const value =\n      q[key] ??\n      body[key] ??\n      root[key] ??\n      submission[key];\n\n    if (value !== undefined && value !== null && String(value).trim() !== \"\") {\n      return String(value).trim();\n    }\n  }\n  return \"\";\n}\n\nfunction yn(value) {\n  const v = String(value ?? \"\").trim().toLowerCase();\n  if ([\"true\", \"yes\", \"y\", \"1\", \"enabled\", \"active\"].includes(v)) return \"Yes\";\n  if ([\"false\", \"no\", \"n\", \"0\", \"disabled\", \"inactive\"].includes(v)) return \"No\";\n  return value ? String(value).trim() : \"No\";\n}\n\nconst spreadsheetId = pick(\"spreadsheet_id\", \"spreadsheetId\", \"Spreadsheet ID\");\n\nif (!spreadsheetId) {\n  throw new Error(\n    `Missing spreadsheet_id. Available Fillout fields: ${Object.keys(q).join(\", \")}`\n  );\n}\n\nreturn [{\n  json: {\n    customer_id: pick(\"customer_id\", \"customerId\", \"Customer ID\"),\n    spreadsheet_id: spreadsheetId,\n    tab_name: pick(\"tab_name\", \"Tab Name\") || \"Bankaccounts\",\n    source: pick(\"source\", \"Source\") || \"wealthyo_dashboard\",\n\n    entry_date: pick(\"entry_date\", \"Entry Date\") || new Date().toISOString().slice(0, 10),\n    bank_name: pick(\"bank_name\", \"Bank Name\"),\n    account_type: pick(\"account_type\", \"Account Type\"),\n    primary_account_type: pick(\"primary_account_type\", \"Primary Account Type\"),\n    account_features: pick(\"account_features\", \"Account Features\", \"Account Features (Optional)\"),\n    bank_address: pick(\"bank_address\", \"Bank Address\"),\n    has_debit_card: yn(pick(\"has_debit_card\", \"Has Debit Card\")),\n    has_credit_card: yn(pick(\"has_credit_card\", \"Has Credit Card\")),\n    has_cheque_book: yn(pick(\"has_cheque_book\", \"Has Cheque Book\")),\n    has_overdraft: yn(pick(\"has_overdraft\", \"Has Overdraft\")),\n    upi_enabled: yn(pick(\"upi_enabled\", \"UPI Enabled\")),\n    ifsc_code: pick(\"ifsc_code\", \"IFSC Code\"),\n    nominee: pick(\"nominee\", \"Nominee\"),\n    upi_id: pick(\"upi_id\", \"UPI ID\"),\n    account_open_date: pick(\"account_open_date\", \"Account Open Date\")\n  }\n}];",
        "mode": "runOnceForEachItem"
      },
