      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const root = $json;\n\nfunction collectNamedArrays(value, found = []) {\n  if (!value || typeof value !== \"object\") return found;\n\n  if (Array.isArray(value.questions)) found.push(value.questions);\n  if (Array.isArray(value.urlParameters)) found.push(value.urlParameters);\n  if (Array.isArray(value.calculations)) found.push(value.calculations);\n\n  if (Array.isArray(value)) {\n    for (const item of value) collectNamedArrays(item, found);\n  } else {\n    for (const item of Object.values(value)) collectNamedArrays(item, found);\n  }\n\n  return found;\n}\n\nconst fields = {};\n\nfor (const list of collectNamedArrays(root)) {\n  for (const item of list) {\n    if (!item || !item.name) continue;\n    fields[String(item.name).trim()] = item.value ?? \"\";\n  }\n}\n\nfunction pick(...keys) {\n  for (const key of keys) {\n    const value = fields[key];\n    if (value !== undefined && value !== null && String(value).trim() !== \"\") {\n      return String(value).trim();\n    }\n  }\n  return \"\";\n}\n\nfunction yesNo(value) {\n  const text = String(value ?? \"\").trim().toLowerCase();\n\n  if ([\"true\", \"yes\", \"y\", \"1\", \"enabled\", \"active\"].includes(text)) {\n    return \"Yes\";\n  }\n\n  if ([\"false\", \"no\", \"n\", \"0\", \"disabled\", \"inactive\"].includes(text)) {\n    return \"No\";\n  }\n\n  return String(value ?? \"\").trim();\n}\n\nfunction asList(value) {\n  if (Array.isArray(value)) return value.join(\", \");\n  return String(value ?? \"\").trim();\n}\n\nconst spreadsheetId = pick(\"spreadsheet_id\", \"spreadsheetId\", \"Spreadsheet ID\");\n\nif (!spreadsheetId) {\n  throw new Error(\n    `Missing spreadsheet_id. Fields received by n8n: ${Object.keys(fields).join(\", \")}`\n  );\n}\n\nreturn {\n  customer_id: pick(\"customer_id\", \"customerId\", \"Customer ID\"),\n  spreadsheet_id: spreadsheetId,\n  tab_name: pick(\"tab_name\", \"tabName\") || \"Bankaccounts\",\n  source: pick(\"source\") || \"wealthyo_dashboard\",\n\n  entry_date:\n    pick(\"entry_date\", \"Entry Date\") || new Date().toISOString().slice(0, 10),\n\n  bank_name: pick(\"bank_name\", \"Bank Name\", \"bank\"),\n\n  account_number: pick(\n    \"account_number\",\n    \"account_number(Optional)\",\n    \"Account Number\",\n    \"Account Number(Optional)\",\n    \"account no\",\n    \"account_no\"\n  ),\n\n  account_type: pick(\"account_type\", \"Account Type\"),\n\n  primary_account_type: pick(\n    \"primary_account_type\",\n    \"Primary Account Type\",\n    \"account_type (1)\",\n    \"Account Type (1)\"\n  ),\n\n  account_features: asList(fields.account_features ?? fields[\"Account Features\"]),\n\n  bank_address: pick(\n    \"bank_address\",\n    \"Bank Address\",\n    \"Address (bank_address)\",\n    \"address\"\n  ),\n\n  has_debit_card: yesNo(pick(\"has_debit_card\", \"Has Debit Card\")),\n  has_credit_card: yesNo(pick(\"has_credit_card\", \"Has Credit Card\")),\n  has_cheque_book: yesNo(pick(\"has_cheque_book\", \"Has Cheque Book\")),\n  has_overdraft: yesNo(pick(\"has_overdraft\", \"Has Overdraft\")),\n  upi_enabled: yesNo(pick(\"upi_enabled\", \"UPI Enabled\")),\n\n  ifsc_code: pick(\"ifsc_code\", \"IFSC Code\"),\n\n  nominee: pick(\n    \"nominee\",\n    \"nominee(Optional)\",\n    \"Nominee\",\n    \"Nominee(Optional)\"\n  ),\n\n  upi_id: pick(\n    \"upi_id\",\n    \"upi_id(Optional)\",\n    \"UPI ID\",\n    \"UPI ID(Optional)\"\n  ),\n\n  account_open_date: pick(\"account_open_date\", \"Account Open Date\")\n};"
      }
