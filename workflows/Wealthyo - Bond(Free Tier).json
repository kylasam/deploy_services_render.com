      "name": "Normalize Fillout Bond Payload",
      "parameters": {
        "jsCode": "const root = $json;\n\nfunction collectNamedArrays(value, found = []) {\n  if (!value || typeof value !== \"object\") return found;\n  if (Array.isArray(value.questions)) found.push(value.questions);\n  if (Array.isArray(value.urlParameters)) found.push(value.urlParameters);\n  if (Array.isArray(value.calculations)) found.push(value.calculations);\n  if (Array.isArray(value)) {\n    for (const item of value) collectNamedArrays(item, found);\n  } else {\n    for (const item of Object.values(value)) collectNamedArrays(item, found);\n  }\n  return found;\n}\n\nconst fields = {};\nfor (const list of collectNamedArrays(root)) {\n  for (const item of list) {\n    if (!item || !item.name) continue;\n    fields[String(item.name).trim()] = item.value ?? \"\";\n  }\n}\n\nfunction pick(...keys) {\n  for (const key of keys) {\n    const value = fields[key];\n    if (value !== undefined && value !== null && String(value).trim() !== \"\") {\n      return String(value).trim();\n    }\n  }\n  return \"\";\n}\n\nfunction cleanNumber(value) {\n  return String(value ?? \"\").replace(/[₹,%]/g, \"\").replace(/,/g, \"\").trim();\n}\n\nconst spreadsheetId = pick(\"spreadsheet_id\", \"spreadsheetId\", \"Spreadsheet ID\");\nif (!spreadsheetId) {\n  throw new Error(`Missing spreadsheet_id. Fields received by n8n: ${Object.keys(fields).join(\", \")}`);\n}\n\nreturn {\n  customer_id: pick(\"customer_id\", \"customerId\", \"Customer ID\"),\n  spreadsheet_id: spreadsheetId,\n  tab_name: pick(\"tab_name\", \"tabName\") || \"Bonds\",\n  source: pick(\"source\") || \"wealthyo_dashboard_single_bond\",\n  entry_mode: pick(\"entry_mode\") || \"single\",\n\n  invest_platform: pick(\"invest_platform\", \"Investment Platform\"),\n  issuer_type: pick(\"issuer_type\", \"Issuer Type\"),\n  sector: pick(\"sector\", \"Sector\"),\n  issuer_domain: pick(\"issuer_domain\", \"Issuer Domain\"),\n  isin: pick(\"isin\", \"ISIN\"),\n  units: cleanNumber(pick(\"units\", \"Units\")),\n  total_investment: cleanNumber(pick(\"total_investment\", \"Total Investment\", \"Investment ₹\")),\n  start_date: pick(\"start_date\", \"Start Date\"),\n  end_date: pick(\"end_date\", \"End Date\"),\n  coupon_rate_pct: cleanNumber(pick(\"coupon_rate_pct\", \"Coupon Rate\", \"Coupon Rate %\")),\n  ytm_pct: cleanNumber(pick(\"ytm_pct\", \"YTM\", \"YTM %\")),\n  interest_payout_frequency_in_months: cleanNumber(pick(\"interest_payout_frequency_in_months\", \"Interest Payout Frequency In Months\")),\n  maturity_amount: cleanNumber(pick(\"maturity_amount\", \"Maturity Amount\", \"Maturity ₹\")),\n  relationship_manager_name: pick(\"relationship_manager_name\", \"Relationship Manager Name\"),\n  relationship_manager_email: pick(\"relationship_manager_email\", \"Relationship Manager Email\"),\n  relationship_manager_phone: pick(\"relationship_manager_phone\", \"Relationship Manager Phone\"),\n  notes: pick(\"notes\", \"Notes\")\n};",
        "mode": "runOnceForEachItem"
      },
