      "name": "Group Alerts Per User & Build HTML",
      "parameters": {
        "jsCode": "const items = $input.all();\nconst propVal = 8500000;\nconst fdVal = 10000;\nconst chitVal = 100000;\nconst sgbVal = 21800;\nconst totalValuation = propVal + fdVal + chitVal + sgbVal;\nconst fmt = (num) => \"\u20b9\" + num.toLocaleString(\"en-IN\");\n\nconst htmlBody = `<!DOCTYPE html>\n<html>\n<body style=\"background-color:#060a12;color:#f4efe4;font-family:sans-serif;padding:24px;\">\n  <div style=\"max-width:640px;margin:0 auto;background:#0f172a;border:2px solid #ffd700;border-radius:24px;padding:32px;\">\n    <div style=\"text-align:center;border-bottom:1px solid rgba(255,215,0,0.3);padding-bottom:20px;margin-bottom:24px;\">\n      <span style=\"background:rgba(0,255,136,0.16);color:#00ff88;border:1px solid rgba(0,255,136,0.4);padding:4px 14px;border-radius:99px;font-size:11px;font-weight:800;letter-spacing:0.12em;\">\u26a1 LIVE EXECUTIVE FINANCIAL REPORT</span>\n      <h1 style=\"color:#ffd700;font-size:28px;margin:10px 0 4px;\">Household Wealth &amp; Portfolio Metrics</h1>\n      <p style=\"color:#cbd5e1;font-size:13px;margin:0;\">Real-time BigQuery Asset Breakdown</p>\n    </div>\n    <p style=\"font-size:15px;margin-bottom:20px;\">Hello <strong>Aru</strong>,</p>\n    <div style=\"display:flex;gap:12px;margin:24px 0;\">\n      <div style=\"flex:1;background:rgba(255,215,0,0.08);border:1px solid rgba(255,215,0,0.3);border-radius:16px;padding:16px;text-align:center;\">\n        <span style=\"font-size:11px;color:#94a3b8;font-weight:700;text-transform:uppercase;\">Total Household Assets</span>\n        <div style=\"font-size:24px;font-weight:900;color:#ffd700;margin-top:6px;\">${fmt(totalValuation)}</div>\n      </div>\n      <div style=\"flex:1;background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.3);border-radius:16px;padding:16px;text-align:center;\">\n        <span style=\"font-size:11px;color:#94a3b8;font-weight:700;text-transform:uppercase;\">Real Estate Valuation</span>\n        <div style=\"font-size:24px;font-weight:900;color:#00ff88;margin-top:6px;\">${fmt(propVal)}</div>\n      </div>\n    </div>\n    <table style=\"width:100%;border-collapse:collapse;margin:24px 0;font-size:13px;text-align:left;\">\n      <thead>\n        <tr style=\"background:rgba(255,255,255,0.08);color:#94a3b8;\">\n          <th style=\"padding:12px;\">Asset Category</th>\n          <th style=\"padding:12px;\">Holdings &amp; Notes</th>\n          <th style=\"padding:12px;text-align:right;\">Calculated Total Value</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr style=\"border-bottom: 1px solid rgba(255,255,255,0.06);\">\n          <td style=\"padding: 12px; color: #ffd700; font-weight: 700;\">\ud83c\udfe1 Property &amp; Real Estate</td>\n          <td style=\"padding: 12px; color: #cbd5e1;\">Whitefield 2BHK</td>\n          <td style=\"padding: 12px; color: #00ff88; font-weight: 700; text-align:right;\">${fmt(propVal)}</td>\n        </tr>\n        <tr style=\"border-bottom: 1px solid rgba(255,255,255,0.06);\">\n          <td style=\"padding: 12px; color: #ffd700; font-weight: 700;\">\ud83e\udd1d Gold Chits &amp; Savings</td>\n          <td style=\"padding: 12px; color: #cbd5e1;\">Chits (Mama)</td>\n          <td style=\"padding: 12px; color: #00ff88; font-weight: 700; text-align:right;\">${fmt(chitVal)}</td>\n        </tr>\n        <tr style=\"border-bottom: 1px solid rgba(255,255,255,0.06);\">\n          <td style=\"padding: 12px; color: #ffd700; font-weight: 700;\">\ud83c\udfc6 Sovereign Gold Bonds (SGB)</td>\n          <td style=\"padding: 12px; color: #cbd5e1;\">SGB DEMO Holdings</td>\n          <td style=\"padding: 12px; color: #00ff88; font-weight: 700; text-align:right;\">${fmt(sgbVal)}</td>\n        </tr>\n        <tr style=\"border-bottom: 1px solid rgba(255,255,255,0.06);\">\n          <td style=\"padding: 12px; color: #ffd700; font-weight: 700;\">\ud83c\udfe6 Fixed Deposits</td>\n          <td style=\"padding: 12px; color: #cbd5e1;\">Bank FDs</td>\n          <td style=\"padding: 12px; color: #00ff88; font-weight: 700; text-align:right;\">${fmt(fdVal)}</td>\n        </tr>\n        <tr style=\"background: rgba(255,215,0,0.12); font-weight:800;\">\n          <td style=\"padding: 14px; color: #ffd700;\" colspan=\"2\">TOTAL NET ASSET VALUATION</td>\n          <td style=\"padding: 14px; color: #00ff88; font-size:15px; text-align:right;\">${fmt(totalValuation)}</td>\n        </tr>\n      </tbody>\n    </table>\n    <div style=\"text-align:center;margin-top:28px;\">\n      <a href=\"https://wealthyo.web.app/dashboard\" style=\"background:linear-gradient(135deg,#ffd700,#f59e0b);color:#060a12;font-weight:900;text-decoration:none;padding:12px 28px;border-radius:14px;display:inline-block;font-size:13px;\">View Complete Live Dashboard \u2197</a>\n    </div>\n  </div>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    from: \"Wealthyo Alerts <alerts@wealthyo.in>\",\n    to: \"arusamy71053@gmail.com\",\n    subject: \"\ud83d\udcb0 [VALUATION STATEMENT] Wealthyo Household Asset & Net Worth Numbers\",\n    html: htmlBody\n  }\n}];"
