      "name": "Normalize Fillout Payload",
      "parameters": {
        "jsCode": "const root = $json;\nconst body = root.body ?? root.data ?? root;\nconst submission = body.submission ?? body;\n\nfunction collectQuestions(...containers) {\n  const out = {};\n  for (const container of containers) {\n    const questions = container?.questions;\n    if (!Array.isArray(questions)) continue;\n    for (const q of questions) {\n      if (!q || !q.name) continue;\n      out[String(q.name).trim()] = q.value ?? \"\";\n    }\n  }\n  return out;\n}\n\nconst q = collectQuestions(root, body, submission, root.body?.submission);\n\nfunction pick(...keys) {\n  for (const key of keys) {\n    const value = q[key] ?? body[key] ?? root[key] ?? submission[key];\n    if (value !== undefined && value !== null && String(value).trim() !== \"\") {\n      return String(value).trim();\n    }\n  }\n  return \"\";\n}\n\nfunction yesNo(value) {\n  const text = String(value ?? \"\").trim().toLowerCase();\n  if ([\"true\", \"yes\", \"y\", \"1\", \"enabled\", \"active\"].includes(text)) return \"Yes\";\n  if ([\"false\", \"no\", \"n\", \"0\", \"disabled\", \"inactive\"].includes(text)) return \"No\";\n  return String(value ?? \"\").trim();\n}\n\nfunction asList(value) {\n  if (Array.isArray(value)) return value.join(\", \");\n  return String(value ?? \"\").trim();\n}\n\nconst spreadsheetId = pick(\"spreadsheet_id\", \"spreadsheetId\", \"Spreadsheet ID\");\nif (!spreadsheetId) {\n  throw new Error(`Missing spreadsheet_id. Available Fillout fields: ${Object.keys(q).join(\", \")}. Open the form from Wealthyo dashboard with ?customer_id=...&spreadsheet_id=...&tab_name=Bankaccounts&source=wealthyo_dashboard`);\n}\n\nreturn [{\n  json: {\n    customer_id: pick(\"customer_id\", \"customerId\", \"Customer ID\"),\n    spreadsheet_id: spreadsheetId,\n    tab_name: pick(\"tab_name\", \"tabName\") || \"Bankaccounts\",\n    source: pick(\"source\") || \"wealthyo_dashboard\",\n    entry_date: pick(\"entry_date\", \"Entry Date\") || new Date().toISOString().slice(0, 10),\n    bank_name: pick(\"bank_name\", \"Bank Name\", \"bank\"),\n    account_number: pick(\"account_number\", \"Account Number\", \"account no\", \"account_no\"),\n    account_type: pick(\"account_type\", \"Account Type\"),\n    primary_account_type: pick(\"primary_account_type\", \"Primary Account Type\"),\n    account_features: asList(q.account_features ?? q[\"Account Features\"] ?? pick(\"account_features\", \"Account Features\")),\n    bank_address: pick(\"bank_address\", \"Bank Address\", \"Address (bank_address)\", \"address\"),\n    has_debit_card: yesNo(pick(\"has_debit_card\", \"Has Debit Card\")),\n    has_credit_card: yesNo(pick(\"has_credit_card\", \"Has Credit Card\")),\n    has_cheque_book: yesNo(pick(\"has_cheque_book\", \"Has Cheque Book\")),\n    has_overdraft: yesNo(pick(\"has_overdraft\", \"Has Overdraft\")),\n    upi_enabled: yesNo(pick(\"upi_enabled\", \"UPI Enabled\")),\n    ifsc_code: pick(\"ifsc_code\", \"IFSC Code\"),\n    nominee: pick(\"nominee\", \"Nominee\"),\n    upi_id: pick(\"upi_id\", \"UPI ID\"),\n    account_open_date: pick(\"account_open_date\", \"Account Open Date\")\n  }\n}];"
      },
