      "name": "Normalize-Bonds(Paid user)",
      "parameters": {
        "jsCode": "const body = $json.body;\nconst bonds = body.submission.questions[0].value;\nconst urlParams = body.submission.urlParameters;\n\nconst customerId = urlParams.find(p => p.id === \"customer_id\")?.value;\nconst spreadsheetId = urlParams.find(p => p.id === \"spreadsheet_id\")?.value;\nconst tabName = urlParams.find(p => p.id === \"tab_name\")?.value;\n\nreturn bonds.map(bond => ({\n  json: {\n    customer_id: customerId,\n    spreadsheet_id: spreadsheetId,\n    tab_name: tabName,\n    invest_platform: bond.invest_platform,\n    issuer_type: bond.issuer_type,\n    sector: bond.sector,\n    issuer_domain: bond.issuer_domain,\n    isin: bond.isin,\n    units: bond.units,\n    total_investment: bond.total_investment,\n    start_date: bond.start_date,\n    end_date: bond.end_date,\n    coupon_rate_pct: bond.coupon_rate_pct,\n    ytm_pct: bond.ytm_pct,\n    interest_payout_frequency_in_months: bond.interest_payout_frequency_in_months,\n    maturity_amount: bond.maturity_amount,\n    relationship_manager_name: bond.relationship_manager_name,\n    relationship_manager_email: bond.relationship_manager_email,\n    notes: bond.notes\n  }\n}));"
      },
