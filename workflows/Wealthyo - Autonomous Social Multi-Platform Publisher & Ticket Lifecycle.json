    {
      "id": "7b4aabc5-65df-4769-901a-dc30d1656026",
      "name": "Resolve Today's Scheduled Calendar Folder",
      "parameters": {
        "jsCode": "// Compute Today's Date in IST (Asia/Kolkata)\nconst now = new Date();\nconst istOffset = 5.5 * 60 * 60 * 1000;\nconst istDate = new Date(now.getTime() + istOffset);\nconst todayStr = istDate.toISOString().slice(0, 10);\n\nconst folders = $input.all().map(item => item.json);\n\n// Match folder starting with today's date YYYY-MM-DD\nlet target = folders.find(f => f.name && f.name.startsWith(todayStr));\n\nif (!target) {\n  // Fallback to closest scheduled future or active folder\n  const dated = folders\n    .filter(f => f.name && /^\\d{4}-\\d{2}-\\d{2}/.test(f.name))\n    .sort((a, b) => a.name.localeCompare(b.name));\n  target = dated.find(f => f.name >= todayStr) || dated[0];\n}\n\nif (!target) {\n  throw new Error(`No scheduled content folder found in Google Drive for ${todayStr}`);\n}\n\nreturn [{\n  json: {\n    today_date: todayStr,\n    scheduled_folder_id: target.id,\n    scheduled_folder_name: target.name\n  }\n}];"
      },
      "position": [
        -1616,
        208
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
