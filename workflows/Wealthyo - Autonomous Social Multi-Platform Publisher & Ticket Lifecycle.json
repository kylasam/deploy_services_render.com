    {
      "id": "ad18421c-a74f-46c2-bb26-a324f2529a1c",
      "name": "Pre-Flight Content Quality Scorer & Sanitizer",
      "parameters": {
        "jsCode": "const metaBinary = $('Google Drive: Download Meta Caption Text').first().binary?.data;\nconst blogBinary = $('Google Drive: Download Blog Markdown').first().binary?.data;\nconst baseInfo = $('Extract Asset File IDs & Video Staging URL').first().json;\n\nlet caption = '';\nif (metaBinary && metaBinary.data) {\n  caption = Buffer.from(metaBinary.data, 'base64').toString('utf-8').trim();\n}\n\nlet blogContent = '';\nif (blogBinary && blogBinary.data) {\n  blogContent = Buffer.from(blogBinary.data, 'base64').toString('utf-8').trim();\n}\n\n// 1. Parse Blog Markdown (Strip YAML frontmatter & extract title)\nlet title = baseInfo.scheduled_folder_name.replace(/^\\d{4}-\\d{2}-\\d{2}_?/, '').replace(/_/g, ' ');\ntitle = title.charAt(0).toUpperCase() + title.slice(1);\n\nconst lines = blogContent.split('\\n');\nfor (const line of lines) {\n  if (line.startsWith('title:')) {\n    title = line.replace('title:', '').trim().replace(/^[\"']|[\"']$/g, '');\n  }\n}\nconst cleanBlogMarkdown = blogContent.replace(/^---[\\s\\S]*?---\\s*/, '').trim();\n\n// 2. Pre-Flight Content Scoring (>80 threshold)\nlet score = 0;\nconst hook = caption.split('\\n')[0] || '';\n\n// Hook Urgency / Numbers Check (25 pts)\nif (hook.length > 15 && (/\\?|₹|!|\\d+%|ALERT|trap/i.test(hook))) score += 25;\nelse score += 10;\n\n// Caption Length & Depth (20 pts)\nif (caption.length > 200) score += 20;\nelse score += 10;\n\n// Wealthyo CTA & Domain Relevance (20 pts)\nif (/wealthyo\\.in|wealthyo/i.test(caption)) score += 20;\n\n// Interactive Comment / Early Access CTA (15 pts)\nif (/comment|claim|waitlist|bio|👇/i.test(caption)) score += 15;\n\n// Hashtag Optimization (20 pts)\nconst hashtags = (caption.match(/#[a-zA-Z0-9_]+/g) || []);\nif (hashtags.length >= 5) score += 20;\nelse if (hashtags.length >= 3) score += 10;\n\nreturn [{\n  json: {\n    ...baseInfo,\n    title: title,\n    caption: caption,\n    hook: hook,\n    hashtags: hashtags,\n    blog_title: title,\n    blog_clean_markdown: cleanBlogMarkdown,\n    preflight_score: score,\n    passed: score >= 80\n  }\n}];"
      },
      "position": [
        -720,
        208
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
