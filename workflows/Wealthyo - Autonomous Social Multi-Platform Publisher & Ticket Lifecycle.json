    {
      "id": "703ee7f1-2dc6-4cee-a2eb-5c219b81dfec",
      "name": "Extract Asset File IDs & Video Staging URL",
      "parameters": {
        "jsCode": "const files = $input.all().map(item => item.json);\nconst folderInfo = $('Resolve Today\\'s Scheduled Calendar Folder').first().json;\n\nconst metaFile = files.find(f => f.name && f.name.includes('meta_instagram_facebook'));\nconst blogFile = files.find(f => f.name && f.name.includes('blog_article'));\nconst ytFile = files.find(f => f.name && f.name.includes('youtube_shorts'));\nconst videoFile = files.find(f => f.name && (f.name.endsWith('.mp4') || f.mimeType === 'video/mp4'));\n\nconst videoName = videoFile ? videoFile.name : 'gemini_generated_video_with_scannable_qr.mp4';\nconst cleanDate = folderInfo.scheduled_folder_name.slice(0, 10);\n\n// GCS Hosted Public Staging URL for Meta Graph ingestion\nconst gcsPublicUrl = `https://storage.googleapis.com/wealthyo-social-media-assets/reels/${cleanDate}_${videoName}`;\n\nreturn [{\n  json: {\n    ...folderInfo,\n    meta_file_id: metaFile ? metaFile.id : null,\n    blog_file_id: blogFile ? blogFile.id : null,\n    youtube_file_id: ytFile ? ytFile.id : null,\n    video_file_id: videoFile ? videoFile.id : null,\n    video_file_name: videoName,\n    video_public_url: gcsPublicUrl\n  }\n}];"
      },
