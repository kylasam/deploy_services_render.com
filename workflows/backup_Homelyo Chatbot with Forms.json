    {
      "id": "9d0526a4-195b-45eb-abfe-271c7a5a897c",
      "name": "Respond (Normal)",
      "parameters": {
        "options": {},
        "respondWith": "json",
        "responseBody": "={\n  \"reply\": \"{{ $node['Groq API'].json.choices[0].message.content.replace(/\\\"/g, '\\\\\\\"') }}\",\n  \"trigger_form\": {{ $node['Groq API'].json.choices[0].message.content.includes(\"I'll open our booking form\") }},\n  \"buttons\": [\n    {\n      \"label\": \"📧 Contact Homelyo\",\n      \"action\": \"open_url\",\n      \"url\": \"mailto:support@homelyo.eu?subject=Homelyo%20Inquiry&body=Hello%20Homelyo%20Team,%0D%0A%0D%0AI%20am%20interested%20in%20a%20room.%0D%0AHere%20are%20my%20details:%0D%0A-%20Full%20Name:%0D%0A-%20Phone%20Number:%0D%0A-%20Message:%0D%0A%0D%0AThank%20you!\"\n    },\n    {\n      \"label\": \"🌐 Visit Homelyo Website\",\n      \"action\": \"open_url\",\n      \"url\": \"https://www.homelyo.eu\"\n    }\n  ]\n}"
      },
