      "name": "Normalize Fillout Physical Gold Payload",
      "parameters": {
        "jsCode": "const root = $json;\n\nfunction collectNamedArrays(value, found = []) {\n  if (!value || typeof value !== \"object\") return found;\n  if (Array.isArray(value.questions)) found.push(value.questions);\n  if (Array.isArray(value.urlParameters)) found.push(value.urlParameters);\n  if (Array.isArray(value.calculations)) found.push(value.calculations);\n  if (Array.isArray(value)) {\n    for (const item of value) collectNamedArrays(item, found);\n  } else {\n    for (const item of Object.values(value)) collectNamedArrays(item, found);\n  }\n  return found;\n}\n\nconst fields = {};\nfor (const list of collectNamedArrays(root)) {\n  for (const item of list) {\n    if (!item || !item.name) continue;\n    fields[String(item.name).trim()] = item.value ?? \"\";\n  }\n}\n\nfunction pick(...keys) {\n  for (const key of keys) {\n    const value = fields[key];\n    if (value !== undefined && value !== null && String(value).trim() !== \"\") return String(value).trim();\n  }\n  return \"\";\n}\n\nfunction cleanNumber(value) {\n  return String(value ?? \"\").replace(/[\u20b9,%]/g, \"\").replace(/,/g, \"\").trim();\n}\n\nfunction yesNo(value) {\n  const text = String(value ?? \"\").trim().toLowerCase();\n  if ([\"true\", \"yes\", \"y\", \"1\", \"enabled\", \"active\"].includes(text)) return \"Yes\";\n  if ([\"false\", \"no\", \"n\", \"0\", \"disabled\", \"inactive\"].includes(text)) return \"No\";\n  return String(value ?? \"\").trim();\n}\n\nfunction asList(value) {\n  if (Array.isArray(value)) return value.join(\", \");\n  return String(value ?? \"\").trim();\n}\n\nconst spreadsheetId = pick(\"spreadsheet_id\", \"spreadsheetId\", \"Spreadsheet ID\");\nif (!spreadsheetId) {\n  throw new Error(`Missing spreadsheet_id. Fields received by n8n: ${Object.keys(fields).join(\", \")}`);\n}\n\nreturn {\n  customer_id: pick(\"customer_id\", \"customerId\", \"Customer ID\"),\n  spreadsheet_id: spreadsheetId,\n  tab_name: pick(\"tab_name\", \"tabName\") || \"Physical Gold\",\n  source: pick(\"source\") || \"wealthyo_dashboard_physical_gold_silver\",\n  category: pick(\"category\", \"Category\") || \"Gold\",\n  item: pick(\"item\", \"Item\", \"item_name\", \"Item Name\", \"ornament_name\", \"Ornament Name\"),\n  type: pick(\"type\", \"Type\", \"gold_type\", \"Gold Type\"),\n  weight_grams: cleanNumber(pick(\"weight_grams\", \"Weight Grams\", \"Weight in grams\")),\n  purity: pick(\"purity\", \"Purity\"),\n  purchase_date: pick(\"purchase_date\", \"Purchase Date\", \"date_of_purchase\"),\n  purchase_amount: cleanNumber(pick(\"purchase_amount\", \"Purchase Amount\", \"total_purchase_amount\", \"Total Purchase Amount\")),\n  bought_from: pick(\"bought_from\", \"Bought From\", \"Where did you buy?\", \"where_did_you_buy\"),\n  has_invoice: yesNo(pick(\"has_invoice\", \"Has Invoice\")),\n  making_charges: cleanNumber(pick(\"making_charges\", \"Making Charges\")),\n  gst_amount: cleanNumber(pick(\"gst_amount\", \"GST Amount\")),\n  certification_or_marking: asList(fields.certification_or_marking ?? fields[\"Certification or marking\"] ?? fields[\"Certification / Marking\"]),\n  is_pledged: yesNo(pick(\"is_pledged\", \"Is Pledged\"))\n};",
        "mode": "runOnceForEachItem"
      },
