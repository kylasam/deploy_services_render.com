      "parameters": {
        "jsCode": "const root = $json;\n\nfunction collectNamedArrays(value, found = []) {\n  if (!value || typeof value !== \"object\") return found;\n\n  if (Array.isArray(value.questions)) found.push(value.questions);\n  if (Array.isArray(value.urlParameters)) found.push(value.urlParameters);\n  if (Array.isArray(value.calculations)) found.push(value.calculations);\n\n  if (Array.isArray(value)) {\n    for (const item of value) collectNamedArrays(item, found);\n  } else {\n    for (const item of Object.values(value)) collectNamedArrays(item, found);\n  }\n\n  return found;\n}\n\nconst fields = {};\nfor (const list of collectNamedArrays(root)) {\n  for (const item of list) {\n    if (!item || !item.name) continue;\n    fields[String(item.name).trim()] = item.value ?? \"\";\n  }\n}\n\nfunction pick(...keys) {\n  for (const key of keys) {\n    const value = fields[key];\n    if (value !== undefined && value !== null && String(value).trim() !== \"\") {\n      return String(value).trim();\n    }\n  }\n  return \"\";\n}\n\nfunction yesNo(value) {\n  const text = String(value ?? \"\").trim().toLowerCase();\n  if ([\"true\", \"yes\", \"y\", \"1\", \"enabled\", \"active\"].includes(text)) return \"Yes\";\n  if ([\"false\", \"no\", \"n\", \"0\", \"disabled\", \"inactive\"].includes(text)) return \"No\";\n  return String(value ?? \"\").trim();\n}\n\nfunction asList(value) {\n  if (Array.isArray(value)) return value.join(\", \");\n  return String(value ?? \"\").trim();\n}\n\nconst spreadsheetId = pick(\"spreadsheet_id\", \"spreadsheetId\", \"Spreadsheet ID\");\nif (!spreadsheetId) {\n  throw new Error(`Missing spreadsheet_id. Fields received by n8n: ${Object.keys(fields).join(\", \")}`);\n}\n\nreturn [{\n  json: {\n    customer_id: pick(\"customer_id\", \"customerId\", \"Customer ID\"),\n    spreadsheet_id: spreadsheetId,\n    tab_name: pick(\"tab_name\", \"tabName\") || \"Bankaccounts\",\n    source: pick(\"source\") || \"wealthyo_dashboard\",\n\n    entry_date: pick(\"entry_date\", \"Entry Date\") || new Date().toISOString().slice(0, 10),\n    bank_name: pick(\"bank_name\", \"Bank Name\", \"bank\"),\n    account_number: pick(\"account_number\", \"account_number(Optional)\", \"Account Number\", \"Account Number(Optional)\", \"account no\", \"account_no\"),\n    account_type: pick(\"account_type\", \"Account Type\"),\n    primary_account_type: pick(\"primary_account_type\", \"Primary Account Type\", \"account_type (1)\", \"Account Type (1)\"),\n    account_features: asList(fields.account_features ?? fields[\"Account Features\"]),\n    bank_address: pick(\"bank_address\", \"Bank Address\", \"Address (bank_address)\", \"address\"),\n    has_debit_card: yesNo(pick(\"has_debit_card\", \"Has Debit Card\")),\n    has_credit_card: yesNo(pick(\"has_credit_card\", \"Has Credit Card\")),\n    has_cheque_book: yesNo(pick(\"has_cheque_book\", \"Has Cheque Book\")),\n    has_overdraft: yesNo(pick(\"has_overdraft\", \"Has Overdraft\")),\n    upi_enabled: yesNo(pick(\"upi_enabled\", \"UPI Enabled\")),\n    ifsc_code: pick(\"ifsc_code\", \"IFSC Code\"),\n    nominee: pick(\"nominee\", \"nominee(Optional)\", \"Nominee\", \"Nominee(Optional)\"),\n    upi_id: pick(\"upi_id\", \"upi_id(Optional)\", \"UPI ID\", \"UPI ID(Optional)\"),\n    account_open_date: pick(\"account_open_date\", \"Account Open Date\")\n  }\n}];"
      },
